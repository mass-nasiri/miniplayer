<Window x:Class="MinimalMusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minimal Music Player" Height="320" Width="620"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#121212" Foreground="#E0E0E0"
        FontFamily="Consolas, Segoe UI"
        Icon="app_icon.ico">

    <Window.Resources>
        <Style TargetType="Button" x:Key="ControlBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#B3B3B3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToggleButton" x:Key="ToggleControlBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#B3B3B3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#1DB954"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Slider" x:Key="MinimalSlider">
            <Setter Property="Background" Value="#282828"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="#FFFFFF" BorderThickness="0" Height="2"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="8" Height="8">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#FFFFFF"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#282828" BorderThickness="0,0,1,0" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Width="120" Height="120" Background="#1F1F1F" BorderBrush="#282828" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Center">
                    <Canvas Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="40" Height="40" Stroke="#282828" StrokeThickness="1" Canvas.Left="10" Canvas.Top="10"/>
                        <Ellipse Width="20" Height="20" Stroke="#282828" StrokeThickness="1" Canvas.Left="20" Canvas.Top="20"/>
                        <Line X1="30" Y1="0" X2="30" Y2="10" Stroke="#282828" StrokeThickness="1"/>
                        <Line X1="30" Y1="50" X2="30" Y2="60" Stroke="#282828" StrokeThickness="1"/>
                    </Canvas>
                </Border>

                <TextBlock x:Name="TxtTitle" Grid.Row="1" Text="Nuvole Bianche" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,12,0,2" HorizontalAlignment="Left"/>
                <TextBlock x:Name="TxtArtist" Grid.Row="2" Text="Ludovico Einaudi" FontSize="12" Foreground="#B3B3B3" Margin="0,0,0,12" HorizontalAlignment="Left"/>

                <Grid Grid.Row="3" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="1:42" FontSize="11" Foreground="#727272" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider Grid.Column="1" Style="{StaticResource MinimalSlider}" Minimum="0" Maximum="100" Value="34"/>
                    <TextBlock Grid.Column="2" Text="4:58" FontSize="11" Foreground="#727272" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource ToggleControlBtn}" Width="32" Height="32">
                        <Path Data="M2,4 L6,4 L10,10 L14,10 M2,12 L6,12 L10,6 L14,6 M11,4 L14,4 L14,7 M11,14 L14,14 L14,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                    </ToggleButton>

                    <Button Style="{StaticResource ControlBtn}" Width="32" Height="32" Click="BtnPrev_Click" Margin="8,0,0,0">
                        <Path Data="M4,6 L4,14 M12,6 L6,10 L12,14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>

                    <Button Style="{StaticResource ControlBtn}" Width="38" Height="38" Click="BtnPlay_Click" Margin="8,0,0,0">
                        <Grid>
                            <Path x:Name="PlayIcon" Data="M6,4 L16,10 L6,16 Z" Fill="#FFFFFF" Visibility="Visible"/>
                            <Path x:Name="PauseIcon" Data="M6,4 L8,4 L8,16 L6,16 M12,4 L14,4 L14,16 L12,16" Fill="#FFFFFF" Visibility="Collapsed"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource ControlBtn}" Width="32" Height="32" Click="BtnNext_Click" Margin="8,0,0,0">
                        <Path Data="M12,6 L12,14 M4,6 L10,10 L4,14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>

                    <ToggleButton Style="{StaticResource ToggleControlBtn}" Width="32" Height="32" Margin="8,0,0,0">
                        <Path Data="M2,6 L12,6 L10,4 M12,6 L10,8 M14,10 L4,10 L6,8 M4,10 L6,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#181818" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="UP NEXT" FontSize="11" FontWeight="Bold" Foreground="#727272" Margin="16,20,16,8" LetterSpacing="1"/>

            <ListBox x:Name="QueueListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" SelectionChanged="QueueListBox_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="#222222"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="0,6,0,6"/>
                        <Setter Property="Template">
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F1F1F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="12,2,12,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TrackNum" Text="{Binding DisplayIndex}" FontSize="11" Foreground="#727272" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock x:Name="TrackName" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#B3B3B3" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="#727272" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="TrackNum" Property="Text" Value="&gt;"/>
                                <Setter TargetName="TrackNum" Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="TrackName" Property="Foreground" Value="#FFFFFF"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
